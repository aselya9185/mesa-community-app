# Copy to .env.local and fill in. NEVER commit real values: only this file is tracked.
# Lines marked "server only" must never be exposed to the browser (do not prefix them with NEXT_PUBLIC_).

# --- public (safe in the browser) -----------------------------------------------------------
# the address of the deployed site; used to build invite links. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL and the public "anon" key (Settings > API). Local: run `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# web push public key (from `node scripts/vapid.mjs`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- server only ----------------------------------------------------------------------------
# bypasses all row level security: used only in the few places listed in CLAUDE.md
SUPABASE_SERVICE_ROLE_KEY=
# web push private key + a contact address push services can use (from `node scripts/vapid.mjs`)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# shared secret the database sends to /api/push (from `node scripts/vapid.mjs`)
PUSH_WEBHOOK_SECRET=
