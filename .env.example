# Copy to .env.local and fill in. Never commit real values.

# public (safe in the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server only: never import into client code
SUPABASE_SERVICE_ROLE_KEY=

# admin contact shown on the login page (wa.me number, digits only)
ADMIN_WHATSAPP=

# web push (generate with: npx web-push generate-vapid-keys), added in M7
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_WEBHOOK_SECRET=
