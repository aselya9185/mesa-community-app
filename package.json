{
  "name": "mesa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test && playwright test --config playwright.demo.config.ts",
    "seed": "node scripts/seed.mjs",
    "db:reset": "supabase db reset",
    "door": "node --no-warnings --experimental-strip-types scripts/door.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "libphonenumber-js": "^1.13.16",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "supabase": "^3.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
